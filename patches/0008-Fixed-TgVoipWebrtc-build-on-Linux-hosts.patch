From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: superheher <heh@vivaldi.net>
Date: Mon, 02 Nov 2026 23:20:44 +0300
Subject: [PATCH 8/8] Fixed TgVoipWebrtc build on Linux hosts.

Applied inside the submodules/TgVoipWebrtc/tgcalls submodule: GCC needs
the explicit <mutex> include, and the Linux importer cannot bridge the
generic NSDictionary element type in the public header.
---
diff --git a/macos/PublicHeaders/TgVoipWebrtc/OngoingCallThreadLocalContext.h b/macos/PublicHeaders/TgVoipWebrtc/OngoingCallThreadLocalContext.h
index 0edca1b..5c5b024 100644
--- a/macos/PublicHeaders/TgVoipWebrtc/OngoingCallThreadLocalContext.h
+++ b/macos/PublicHeaders/TgVoipWebrtc/OngoingCallThreadLocalContext.h
@@ -371,9 +371,9 @@ typedef NS_ENUM(int32_t, OngoingGroupCallRequestedVideoQuality) {
 
 @interface OngoingGroupCallStats : NSObject
 
-@property (nonatomic, strong, readonly) NSDictionary<NSString *, OngoingGroupCallIncomingVideoStats *> * _Nonnull incomingVideoStats;
+@property (nonatomic, strong, readonly) NSDictionary * _Nonnull incomingVideoStats;
 
-- (instancetype _Nonnull)initWithIncomingVideoStats:(NSDictionary<NSString *, OngoingGroupCallIncomingVideoStats *> * _Nonnull)incomingVideoStats;
+- (instancetype _Nonnull)initWithIncomingVideoStats:(NSDictionary * _Nonnull)incomingVideoStats;
 
 @end
 
diff --git a/tgcalls/group/GroupInstanceReferenceImpl.cpp b/tgcalls/group/GroupInstanceReferenceImpl.cpp
index 78e5bb2..3acb9dd 100644
--- a/tgcalls/group/GroupInstanceReferenceImpl.cpp
+++ b/tgcalls/group/GroupInstanceReferenceImpl.cpp
@@ -56,6 +56,7 @@
 #include <algorithm>
 #include <cmath>
 #include <map>
+#include <mutex>
 #include <set>
 #include <sstream>
 
-- 
