index 94b898dcbe..c3866c298a 100644
--- a/submodules/CloudData/Sources/CloudData.swift
+++ b/submodules/CloudData/Sources/CloudData.swift
@@ -11,6 +11,22 @@ private enum FetchError {
 
 @available(iOS 10.0, *)
 private func fetchRawData(prefix: String) -> Signal<Data, FetchError> {
+    #if TGBUILD
+    // CKContainer.default() traps (EXC_BREAKPOINT) without the iCloud entitlement,
+    // which the free-provisioned profile lacks. Return an async .generic error — async
+    // because the upstream `|> restart` chain re-enters synchronously (a synchronous
+    // error stack-overflows).
+    return Signal { subscriber in
+        let queue = Queue.mainQueue()
+        let timer = SwiftSignalKit.Timer(timeout: 0.1, repeat: false, completion: {
+            subscriber.putError(.generic)
+        }, queue: queue)
+        timer.start()
+        return ActionDisposable {
+            timer.invalidate()
+        }
+    }
+    #else
     return Signal { subscriber in
         let container = CKContainer.default()
         let publicDatabase = container.database(with: .public)
@@ -45,6 +61,7 @@ private func fetchRawData(prefix: String) -> Signal<Data, FetchError> {
         return ActionDisposable {
         }
     }
+    #endif
 }
 
 @available(iOS 10.0, *)
