 8 files changed, 88 insertions(+), 8 deletions(-)

diff --git a/submodules/TelegramApi/Sources/TLObjectSupport.swift b/submodules/TelegramApi/Sources/TLObjectSupport.swift
index 8b3cf95e00..a285cca51e 100644
--- a/submodules/TelegramApi/Sources/TLObjectSupport.swift
+++ b/submodules/TelegramApi/Sources/TLObjectSupport.swift
@@ -97,6 +97,18 @@ func tlDescribedValue(_ field: TLFieldInfo, _ scalar: UnsafeRawPointer?, _ objec
 /// enum values, so the logger's type-qualified redaction keys ("User.user") still match.
 func tlDescriptionFields(_ object: TLObject) -> (String, [(String, ConstructorParameterDescription)]) {
     var fields: [(String, ConstructorParameterDescription)] = []
+    #if TGBUILD
+    // Some payloads in the Linux build do not answer the @objc tl_constructorInfo
+    // selector, and MTLog's description path is the only consumer — degrade to a
+    // placeholder instead of raising doesNotRecognizeSelector from inside a request.
+    if let nsObject = object as? NSObject {
+        if !nsObject.responds(to: Selector(("tl_constructorInfo"))) {
+            return ("unknown", fields)
+        }
+    } else {
+        return ("unknown", fields)
+    }
+    #endif
     withUnsafeMutablePointer(to: &fields) { pointer in
         TLObjectDescribe(object, pointer) { context, field, scalar, value in
             let fields = context!.assumingMemoryBound(to: [(String, ConstructorParameterDescription)].self)
diff --git a/submodules/TelegramCore/Sources/Network/Network.swift b/submodules/TelegramCore/Sources/Network/Network.swift
index 7a8db1d872..6817513726 100644
--- a/submodules/TelegramCore/Sources/Network/Network.swift
+++ b/submodules/TelegramCore/Sources/Network/Network.swift
@@ -1534,8 +1534,10 @@ class Keychain: NSObject, MTKeychain {
         self.remove = remove
     }
     
-    func setObject(_ object: Any!, forKey aKey: String!, group: String!) {
-        guard let object = object else {
+    func setObject(_ object: Any, forKey aKey: String, group: String) {
+        // tgbuild: the unbridged requirement passes a non-optional id; nil never arrives.
+        let object: Any? = object
+        if object == nil {
             return
         }
         MTContext.perform(objCTry: {
@@ -1545,7 +1547,32 @@ class Keychain: NSObject, MTKeychain {
         })
     }
     
-    func dictionary(forKey aKey: String!, group: String!) -> [AnyHashable : Any]? {
+    /// tgbuild: the Linux Swift driver cannot bridge NSDictionary-requirements to
+    /// Dictionary without Apple's apinotes, so the Linux build implements the @objc
+    /// requirement in its unbridged form. Runtime behavior is identical (the same
+    /// unarchived NSDictionary flows to the engine); macOS keeps the bridged signature.
+    #if TGBUILD
+    func dictionary(forKey aKey: String, group: String) -> Any? {
+        // tgbuild: non-optional parameters under the Linux importer
+        let aKey: String? = aKey
+        let group: String? = group
+        guard let aKey = aKey, let group = group else {
+            return nil
+        }
+        if let data = self.get(group + ":" + aKey) {
+            let result = MTDeprecated.unarchiveDeprecated(with: data as Data) as? NSDictionary
+            if let result = result {
+                return result
+            }
+            assertionFailure("Unexpected keychain entry type")
+        }
+        return nil
+    }
+    #else
+    func dictionary(forKey aKey: String, group: String) -> [AnyHashable : Any]? {
+        // tgbuild: non-optional parameters under the Linux importer
+        let aKey: String? = aKey
+        let group: String? = group
         guard let aKey = aKey, let group = group else {
             return nil
         }
@@ -1559,8 +1586,12 @@ class Keychain: NSObject, MTKeychain {
         }
         return nil
     }
+    #endif
     
-    func number(forKey aKey: String!, group: String!) -> NSNumber? {
+    func number(forKey aKey: String, group: String) -> NSNumber? {
+        // tgbuild: non-optional parameters under the Linux importer
+        let aKey: String? = aKey
+        let group: String? = group
         guard let aKey = aKey, let group = group else {
             return nil
         }
@@ -1575,7 +1606,7 @@ class Keychain: NSObject, MTKeychain {
         return nil
     }
     
-    func removeObject(forKey aKey: String!, group: String!) {
+    func removeObject(forKey aKey: String, group: String) {
         self.remove(group + ":" + aKey)
     }
 }
