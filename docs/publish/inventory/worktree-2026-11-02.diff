+#if TGBUILD
+// The Linux build's only working app-level diagnostic channel: appends to
+// Documents/tgbuild-log.txt (read with `pymobiledevice3 apps afc` pull). The device
+// syslog does not carry the app's NSLog output and debugserver attach is denied on the
+// free account. The synthesized main binary (link.py) logs "main: …" lines to the same
+// file with the same format.
+func tgbuildLog(_ text: String) {
+    let formatter = DateFormatter()
+    formatter.locale = Locale(identifier: "en_US_POSIX")
+    formatter.timeZone = TimeZone(identifier: "UTC")
+    formatter.dateFormat = "yyyy-MM-dd HH:mm:ss Z"
+    let line = "\(formatter.string(from: Date())) [tgbuild] \(text)\n"
+    if let documents = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first {
+        let path = documents.appendingPathComponent("tgbuild-log.txt").path
+        if let handle = FileHandle(forWritingAtPath: path) {
+            handle.seekToEndOfFile()
+            handle.write(line.data(using: .utf8)!)
+            handle.closeFile()
+        } else {
+            try? line.data(using: .utf8)?.write(to: URL(fileURLWithPath: path))
+        }
+    }
+}
+#endif
