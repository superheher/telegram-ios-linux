+@objc public final class ChatListNodeDebugLog: NSObject {
+    static var didLogView = false
+    static func log(_ s: String) {
+        let path = (NSSearchPathForDirectoriesInDomains(.documentDirectory, .userDomainMask, true).first ?? "/tmp") + "/tgbuild-log.txt"
+        if !FileManager.default.fileExists(atPath: path) {
+            FileManager.default.createFile(atPath: path, contents: nil)
+        }
+        if let handle = FileHandle(forWritingAtPath: path) {
+            handle.seekToEndOfFile()
+            if let data = "\(Date()) [tgbuild] \(s)\n".data(using: .utf8) {
+                handle.write(data)
+            }
+            try? handle.close()
+        }
+    }
+}
