diff --git a/Telegram/Telegram-iOS/main.m b/Telegram/Telegram-iOS/main.m
index 81d976a847..98010743c9 100644
--- a/Telegram/Telegram-iOS/main.m
+++ b/Telegram/Telegram-iOS/main.m
@@ -1,7 +1,51 @@
 #import <UIKit/UIKit.h>
+#import <pthread.h>
+#import <string.h>
+#import <stdio.h>
+
+#if TGBUILD
+// The Linux build links the app binary from raw .o files (link.py); these breadcrumbs
+// make a silent startup failure visible. The device syslog does not carry the app's
+// NSLog output, so the lines also append to Documents/tgbuild-log.txt, which pulls out
+// via `pymobiledevice3 apps pull` (house_arrest).
+static void tglog(NSString *s) {
+    NSString *line = [NSString stringWithFormat:@"%@ [tgbuild] %@\n", [NSDate date], s];
+    NSLog(@"%@", line);
+    NSString *dir = [NSSearchPathForDirectoriesInDomains(NSDocumentDirectory, NSUserDomainMask, YES) firstObject];
+    if (!dir) return;
+    NSString *path = [dir stringByAppendingPathComponent:@"tgbuild-log.txt"];
+    FILE *f = fopen(path.fileSystemRepresentation, "a");
+    if (f) {
+        fwrite(line.UTF8String, 1, strlen(line.UTF8String), f);
+        fclose(f);
+    }
+}
+
+static void *tgbuild_heartbeat(void *arg) {
+    for (int i = 1; ; i++) {
+        sleep(5);
+        tglog([NSString stringWithFormat:@"heartbeat %d", i]);
+    }
+    return NULL;
+}
+#endif
 
 int main(int argc, char *argv[]) {
     @autoreleasepool {
+#if TGBUILD
+        tglog(@"main: entry");
+        NSString *bundlePath = [[NSBundle mainBundle] bundlePath];
+        tglog([NSString stringWithFormat:@"main: bundle %@", bundlePath]);
+        tglog([NSString stringWithFormat:@"main: classes Application=%@ AppDelegate=%@",
+              NSClassFromString(@"Application") ? @"found" : @"MISSING",
+              NSClassFromString(@"AppDelegate") ? @"found" : @"MISSING"]);
+        NSArray *contents = [[NSFileManager defaultManager]
+                             contentsOfDirectoryAtPath:bundlePath error:nil];
+        tglog([NSString stringWithFormat:@"main: bundle contents %@", contents]);
+        pthread_t hb;
+        pthread_create(&hb, NULL, tgbuild_heartbeat, NULL);
+        tglog(@"main: calling UIApplicationMain");
+#endif
         return UIApplicationMain(argc, argv, @"Application", @"AppDelegate");
     }
 }
