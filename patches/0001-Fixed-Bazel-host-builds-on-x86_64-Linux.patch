+    "//conditions:default": arm64_specific_flags,
+}) + select({
+    "@build_bazel_rules_apple//apple:ios_arm64": apple_specific_flags,
+    "//build-system:ios_sim_arm64": apple_specific_flags,
+    "@platforms//os:linux": linux_specific_flags,
+    "//conditions:default": apple_specific_flags,
+}) + platform_shared_flags
 
