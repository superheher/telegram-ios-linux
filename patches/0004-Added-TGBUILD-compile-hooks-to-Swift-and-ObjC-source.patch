diff --git a/submodules/UIKitRuntimeUtils/Source/UIKitRuntimeUtils/UIBarButtonItem+Proxy.h b/submodules/UIKitRuntimeUtils/Source/UIKitRuntimeUtils/UIBarButtonItem+Proxy.h
index 69b8a6a340..5d326faf3c 100644
--- a/submodules/UIKitRuntimeUtils/Source/UIKitRuntimeUtils/UIBarButtonItem+Proxy.h
+++ b/submodules/UIKitRuntimeUtils/Source/UIKitRuntimeUtils/UIBarButtonItem+Proxy.h
@@ -1,5 +1,10 @@
 #import <UIKit/UIKit.h>
-#import <AsyncDisplayKit/ASDisplayNode.h>
+
+// Forward declaration, not the import: a public header that pulls in another module's
+// header shadows that module's own declarations when both modules load in one compile
+// (ClangImporter then resolves ASDisplayNode under UIKitRuntimeUtils and hides the real
+// AsyncDisplayKit declarations). Pointer use only, so @class is sufficient.
+@class ASDisplayNode;
 
 typedef void (^UIBarButtonItemSetTitleListener)(NSString *);
 typedef void (^UIBarButtonItemSetEnabledListener)(BOOL);
diff --git a/submodules/WebProxyTransport/Sources/WebProxyDiagnostics.swift b/submodules/WebProxyTransport/Sources/WebProxyDiagnostics.swift
index 7f99f144b5..1a56fca4a9 100644
--- a/submodules/WebProxyTransport/Sources/WebProxyDiagnostics.swift
+++ b/submodules/WebProxyTransport/Sources/WebProxyDiagnostics.swift
@@ -1,5 +1,7 @@
 import Foundation
+#if canImport(os.log)
 import os.log
+#endif
 
 enum WebProxyCarrierFailure: String {
     case construction = "webview-construction"
@@ -21,6 +23,7 @@ enum WebProxyCarrierFailure: String {
 }
 
 enum WebProxyDiagnostics {
+#if canImport(os.log)
     private static let log = OSLog(subsystem: "org.telegram.WebProxyTransport", category: "carrier")
 
     static func info(_ event: StaticString) {
@@ -64,4 +67,22 @@ enum WebProxyDiagnostics {
             mimeType ?? "none"
         )
     }
+#else
+    // Linux build (no os.log module in the SDK-free toolchain): diagnostics drop. The
+    // logging surface here is carrier diagnostics, not user-visible behavior.
+    static func info(_ event: StaticString) {
+    }
+
+    static func failure(_ reason: WebProxyCarrierFailure) {
+    }
+
+    static func pageStatus(_ status: WebProxyPageStatus) {
+    }
+
+    static func navigationFailure(_ error: Error) {
+    }
+
+    static func rejectedResponse(statusCode: Int?, mimeType: String?) {
+    }
+#endif
 }
diff --git a/submodules/WebProxyTransport/Sources/WebProxyWebViewCarrier.swift b/submodules/WebProxyTransport/Sources/WebProxyWebViewCarrier.swift
index 30fadaaff1..92c223fffd 100644
